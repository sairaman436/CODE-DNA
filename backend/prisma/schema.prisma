generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String            @id @default(uuid())
  github_id           String?           @unique
  github_username     String?           @unique
  username            String?           @unique
  password            String?
  email               String?           @unique
  phone_number        String?           @unique
  country_code        String?
  display_name        String?
  avatar_url          String?
  github_token        String?
  plan                String?           @default("free")
  created_at          DateTime?         @default(now())
  last_analyzed_at    DateTime?
  codedna_username    String?           @unique
  email_verified      Boolean?          @default(false)
  username_changed_at DateTime?
  role                String            @default("USER") // "USER", "ADMIN", or "STAFF"
  staff_type          String?           // "MANAGER", "PR", "SENIOR_DEV", etc.
  failed_attempts     Int               @default(0)
  lockout_until       DateTime?
  status              String            @default("ACTIVE") // "ACTIVE", "BANNED"
  bio                 String?
  cover_url           String?
  accent_theme        String?           @default("emerald")
  pinned_badges       String?           @default("")
  analysis_jobs       AnalysisJob[]
  vectors             DeveloperVector[]
  fingerprints        Fingerprint[]
  activity_logs       ActivityLog[]

  @@map("users")
}

model ActivityLog {
  id         String   @id @default(uuid())
  user_id    String?
  action     String   // e.g., "LOGIN", "REGISTER", "PROFILE_EDIT", "ANALYSIS_START"
  details    String?  // JSON string or description
  ip_address String?
  user_agent String?
  created_at DateTime @default(now())
  user       User?    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("activity_logs")
}

model OtpCode {
  id         String   @id @default(uuid())
  email      String
  code       String
  expires_at DateTime
  used       Boolean  @default(false)
  created_at DateTime @default(now())

  @@map("otp_codes")
}

model Fingerprint {
  id                      String          @id @default(uuid())
  user_id                 String?
  readability_score       Int?
  complexity_score        Int?
  documentation_score     Int?
  test_mindset_score      Int?
  commit_discipline_score Int?
  language_depth_score    Int?
  refactor_tendency_score Int?
  error_handling_score    Int?
  developer_type          String?
  personality_summary     String?
  strengths               String?
  growth_areas            String?
  created_at              DateTime?       @default(now())
  repos_analyzed          Int?            @default(0)
  total_files_analyzed    Int?            @default(0)
  activity_pulse          String?
  commit_patterns         CommitPattern[]
  user                    User?           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  language_stats          LanguageStat[]

  @@map("fingerprints")
}

model LanguageStat {
  id             String       @id @default(uuid())
  fingerprint_id String?
  language       String?
  total_lines    Int?
  total_commits  Int?
  trend          String?
  claimed_in_bio Boolean?     @default(false)
  fingerprint    Fingerprint? @relation(fields: [fingerprint_id], references: [id], onDelete: Cascade)

  @@map("language_stats")
}

model CommitPattern {
  id                   String       @id @default(uuid())
  fingerprint_id       String?
  avg_message_length   Float?
  commit_style         String?
  most_active_hour     Int?
  most_active_day      String?
  avg_commit_size      Int?
  fix_to_feature_ratio Float?
  emoji_usage_pct      Float?
  avg_fn_length        Int?
  naming_style         String?
  fingerprint          Fingerprint? @relation(fields: [fingerprint_id], references: [id], onDelete: Cascade)

  @@map("commit_patterns")
}

model DeveloperVector {
  id         String    @id @default(uuid())
  user_id    String?
  embedding  String?
  updated_at DateTime? @default(now())
  user       User?     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("developer_vectors")
}

model AnalysisJob {
  id            String    @id @default(uuid())
  user_id       String?
  status        String?   @default("pending")
  progress      Int?      @default(0)
  current_step  String?
  error_message String?
  created_at    DateTime? @default(now())
  completed_at  DateTime?
  user          User?     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("analysis_jobs")
}
