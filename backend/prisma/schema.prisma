generator client {
  provider        = "prisma-client-js"
}

datasource db {
  provider   = "sqlite"
  url        = env("DATABASE_URL")
}

model User {
  id               String            @id @default(uuid())
  github_id        String            @unique
  username         String
  display_name     String?
  avatar_url       String?
  github_token     String?
  plan             String?           @default("free")
  created_at       DateTime?         @default(now())
  last_analyzed_at DateTime?         
  analysis_jobs    AnalysisJob[]
  vectors          DeveloperVector[]
  fingerprints     Fingerprint[]

  @@map("users")
}

model Fingerprint {
  id                      String            @id @default(uuid())
  user_id                 String?
  readability_score       Int?
  complexity_score        Int?
  documentation_score     Int?
  test_mindset_score      Int?
  commit_discipline_score Int?
  language_depth_score    Int?
  refactor_tendency_score Int?
  error_handling_score    Int?
  developer_type          String?
  personality_summary     String?
  strengths               String? // Stored as stringified JSON in sqlite
  growth_areas            String? // Stored as stringified JSON in sqlite
  repos_analyzed          Int?      @default(0)
  total_files_analyzed    Int?      @default(0)
  activity_pulse          String?   // JSON array of activity density for 90 days
  created_at              DateTime?         @default(now())
  commit_patterns         CommitPattern[]
  user                    User?             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  language_stats          LanguageStat[]

  @@map("fingerprints")
}

model LanguageStat {
  id             String       @id @default(uuid())
  fingerprint_id String?
  language       String?
  total_lines    Int?
  total_commits  Int?
  trend          String?
  claimed_in_bio Boolean?     @default(false)
  fingerprint    Fingerprint? @relation(fields: [fingerprint_id], references: [id], onDelete: Cascade)

  @@map("language_stats")
}

model CommitPattern {
  id                   String       @id @default(uuid())
  fingerprint_id       String?
  avg_message_length   Float?
  commit_style         String?
  most_active_hour     Int?
  most_active_day      String?
  avg_commit_size      Int?
  fix_to_feature_ratio Float?
  emoji_usage_pct      Float?
  naming_style         String?
  avg_fn_length        Int?
  fingerprint          Fingerprint? @relation(fields: [fingerprint_id], references: [id], onDelete: Cascade)

  @@map("commit_patterns")
}

model DeveloperVector {
  id         String                               @id @default(uuid())
  user_id    String?
  embedding  String?                              // Stored as stringified JSON array of 8 floats
  updated_at DateTime?                            @default(now())
  user       User?                                @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("developer_vectors")
}

model AnalysisJob {
  id           String    @id @default(uuid())
  user_id      String?
  status       String?   @default("pending")
  progress     Int?      @default(0)
  current_step String?
  error_message String?
  created_at   DateTime? @default(now())
  completed_at DateTime? 
  user         User?     @relation(fields: [user_id], references: [id])

  @@map("analysis_jobs")
}
